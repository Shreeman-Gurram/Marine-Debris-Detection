# ==============================================================================
# SONARIS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In production, set these variables directly in your cloud platform dashboard.
# NEVER commit real credentials or .env files to GitHub.
# ==============================================================================

# Database: MongoDB Atlas connection string (REQUIRED)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# CORS: Comma-separated list of allowed frontend origins (Optional, defaults to localhost)
# Production example: https://marine-debris-detection.vercel.app
ALLOWED_ORIGINS=

# ML Model: Direct download URL for best_detector.pt (REQUIRED for cloud deployments)
# Example: https://github.com/<owner>/<repo>/releases/download/v1.0.0/best_detector.pt
MODEL_DOWNLOAD_URL=

# Storage: Path to store generated evidence images (Optional, defaults to outputs/evidence/)
# Production example (persistent disk): /var/data/evidence
EVIDENCE_DIR=

# Port: HTTP listening port (Provided automatically by Render/Railway via $PORT)
PORT=8000

# Frontend: Backend API URL for Vercel builds (Set in Vercel Environment Variables)
# Example: https://sonaris-api.onrender.com
VITE_API_URL=
